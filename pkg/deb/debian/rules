#!/usr/bin/make -f

export DH_VERBOSE = 1

# Exported by pkg/build-deb.sh; the default keeps a manual build here working.
# A major bump also needs debian/control's Source and Package updated.
RAG_SERVER_MAJOR ?= 2
PKG := pgedge-rag-server$(RAG_SERVER_MAJOR)
# Hardcoded, matching the RPM: the unit file embeds this path.
INSTALLROOT := /usr/pgedge/rag-server$(RAG_SERVER_MAJOR)
DESTROOT := debian/$(PKG)$(INSTALLROOT)

%:
	dh $@

override_dh_builddeb:
	dh_builddeb -- -Zgzip

override_dh_auto_install:
	# --- SBOM generation and signing ---
	mkdir -p debian/tmp/sbom
	syft dir:$(CURDIR) -o cyclonedx-json > debian/tmp/sbom/pgedge-rag-server-sbom.json || exit 1
	# Extract the signing key id and sign in ONE shell line: in a Makefile
	# recipe, $$(...) is shell command substitution, $$5 is awk's $5, and
	# joining with '; \' keeps KEY_ID in scope for the gpg call.
	KEY_ID=$$(gpg --list-secret-keys --with-colons | awk -F: '/^sec/{print $$5}' | head -n 1); \
	gpg --armor --detach-sign --local-user "$$KEY_ID" \
		--output debian/tmp/sbom/pgedge-rag-server-sbom.json.asc \
		debian/tmp/sbom/pgedge-rag-server-sbom.json || exit 1
	# Source filenames stay unsuffixed; only the destinations carry the
	# major. No usr/bin entry: 1.x owns /usr/bin/pgedge-rag-server.
	install -D -m 0755 pgedge-rag-server $(DESTROOT)/bin/pgedge-rag-server
	install -D -m 0644 debian/pgedge-rag-server.yaml debian/$(PKG)/etc/pgedge/$(PKG).yaml
	install -D -m 0644 debian/tmp/sbom/pgedge-rag-server-sbom.json $(DESTROOT)/sbom/pgedge-rag-server-sbom.json
	install -D -m 0644 debian/tmp/sbom/pgedge-rag-server-sbom.json.asc $(DESTROOT)/sbom/pgedge-rag-server-sbom.json.asc
	install -D -m 0644 debian/pgedge-rag-server.tmpfiles.conf debian/$(PKG)/usr/lib/tmpfiles.d/$(PKG).conf
	install -D -m 0644 debian/pgedge-rag-server.logrotate debian/$(PKG)/etc/logrotate.d/$(PKG)
	rm -rf debian/tmp/sbom

override_dh_installsystemd:
	dh_installsystemd --name=$(PKG) --no-stop-on-upgrade
